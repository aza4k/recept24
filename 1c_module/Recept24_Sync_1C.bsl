// =========================================================================
// Ушбу код 1С:Аптека / 1С:Розница тизимлари учун мўлжалланган.
// Фойдаланиш: Тезкор ишлов берувчи (Внешняя обработка) ёки Фоновое задание сифатида.
// =========================================================================

Процедура ВыполнитьСинхронизациюRecept24() Экспорт

    // 1. Созламалар (Ҳар бир дорихона учун шахсий)
    СерверАдрес  = "web-production-13565.up.railway.app"; // Recept24 сервер манзили
    ApiKey       = "rec_SINDING_DORIXONA_API_KEY";        // Дорихона шахсий API kaliti
    ИспользоватьSSL = Истина;

    // 2. 1С Базасидан қолдиқлар ва нархларни олиш
    // Изоҳ: Конфигурацияга қараб регистр номи (ТоварыВРознице / ОстаткиНоменклатуры) ўзгариши мумкин
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Номенклатура.Наименование КАК Наименование,
        |   Номенклатура.Штрихкод КАК Штрихкод,
        |   Остатки.КоличествоОстаток КАК Количество,
        |   Цены.Цена КАК Цена
        |ИЗ
        |   РегистрНакопления.ТоварыВРознице.Остатки(&Период, ) КАК Остатки
        |   ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
        |       ПО Остатки.Номенклатура = Номенклатура.Ссылка
        |   ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, ) КАК Цены
        |       ПО Остатки.Номенклатура = Цены.Номенклатура
        |ГДЕ
        |   Остатки.КоличествоОстаток > 0";

    Запрос.УстановитьПараметр("Период", ТекущаяДата());
    Выборка = Запрос.Выполнить().Выбрать();

    // 3. JSON форматга йиғиш
    МассивТоваров = Новый Массив;

    Пока Выборка.Следующий() Цикл
        СтруктураТовара = Новый Структура;
        СтруктураТовара.Вставить("name", СокрЛП(Выборка.Наименование));
        СтруктураТовара.Вставить("barcode", СокрЛП(Выборка.Штрихкод));
        СтруктураТовара.Вставить("price", Выборка.Цена);
        СтруктураТовара.Вставить("quantity", Выборка.Количество);
        СтруктураТовара.Вставить("in_stock", Истина);

        МассивТоваров.Добавить(СтруктураТовара);
    КонецЦикла;

    ГлавнаяСтруктура = Новый Структура;
    ГлавнаяСтруктура.Вставить("items", МассивТоваров);

    // JSON сатр яратиш
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, ГлавнаяСтруктура);
    СтрокаJSON = ЗаписьJSON.Закрыть();

    // 4. HTTP POST сўровини Recept24 серверига жўнатиш
    Попытка
        Если ИспользоватьSSL Тогда
            SSLСоединение = Новый ЗащищенноеСоединениеOpenSSL();
            HTTPСоединение = Новый HTTPСоединение(СерверАдрес, 443, , , , 30, SSLСоединение);
        Иначе
            HTTPСоединение = Новый HTTPСоединение(СерверАдрес, 80, , , , 30);
        КонецЕсли;

        HTTPЗапрос = Новый HTTPЗапрос("/api/sync/1c/");
        HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        HTTPЗапрос.Заголовки.Вставить("X-Pharmacy-Key", ApiKey);
        HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);

        Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);

        Если Ответ.КодСостояния = 200 Тогда
            Сообщить("Recept24: Синхронизация муваффақиятли якунланди! Жавоб: " + Ответ.ПолучитьТелоКакСтроку());
        Иначе
            Сообщить("Recept24 ХАТОЛИК: Код " + Строка(Ответ.КодСостояния) + " - " + Ответ.ПолучитьТелоКакСтроку());
        КонецЕсли;

    Исключение
        Сообщить("Recept24 тармоқ хатолиги: " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры
